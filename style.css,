/* Remove all white space */
body {
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
  background: #f0f0f0;
}

/* Full width box for mobile */
.box {
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 20px 15px;
  background: white;
  border-radius: 0;
  box-shadow: none;
  box-sizing: border-box;
  min-height: 100vh; /* make it tall */
}

h2 {
  color: #006400;
  margin-top: 0;
}

button {
  background: #006400;
  color: white;
  border: none;
  padding: 12px 20px;
  width: 100%;
  border-radius: 8px;
  font-size: 16px;
  margin-top: 10px;
}

a {
  color: #006400;
  text-decoration: none;
  font-weight: bold;
}

video {
  width: 100%;
  border-radius: 10px;
  margin: 15px 0;
}
